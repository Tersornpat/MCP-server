# Copy to .env.local for local development. Never commit real values.

# iCloud sign-in. Create the app-specific password at https://account.apple.com
# (Sign-In and Security -> App-Specific Passwords).
APPLE_ID=you@example.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# What you type on the Allow page when connecting Claude. At least 16 characters.
LOGIN_PASSPHRASE=

# Signs and encrypts OAuth tokens. At least 32 characters, e.g. `openssl rand -base64 48`.
# Changing it signs every connected client out.
TOKEN_SECRET=

# Optional
DEFAULT_CALENDAR_NAME=MCP-project
TIMEZONE=Asia/Bangkok
# CALDAV_URL=https://caldav.icloud.com
